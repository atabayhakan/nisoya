# Nisoya — Üretim ortamı şablonu. Sunucuda .env olarak kopyalanır, doldurulur.
# APP_KEY için: php artisan key:generate

APP_NAME=Nisoya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nisoya.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# Veritabanı (Hostinger VPS — MySQL/MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nisoya
DB_USERNAME=nisoya
DB_PASSWORD=

# Oturum & önbellek & kuyruk
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-posta (gerçek SMTP — Hostinger e-posta veya harici sağlayıcı)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="destek@nisoya.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Google AdSense (gelir kaynağı)
# ----------------------------------------------------------------------------
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_AUTO_ADS_CODE=

# ----------------------------------------------------------------------------
# Google Analytics 4
# ----------------------------------------------------------------------------
ANALYTICS_ENABLED=false
ANALYTICS_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# Bağış (PayPal.me + IBAN)
# ----------------------------------------------------------------------------
DONATION_PAYPAL_ME=
DONATION_IBAN=
DONATION_IBAN_OWNER=

# ----------------------------------------------------------------------------
# Reverse Geocoding (Nominatim / OpenStreetMap)
# ----------------------------------------------------------------------------
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_CACHE_DAYS=30
