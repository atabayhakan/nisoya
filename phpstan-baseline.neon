; PHPStan baseline — audit'te tespit edilen tüm 216+ hata burada
; suppress edilir. Yeni yazılan kodun PHPStan'da temiz olması için
; baseline kullanılır; mevcut hatalar CI'da fail etmez.
;
; Yenileme: vendor/bin/phpstan analyse app --generate-baseline
; --memory-limit=2G (Linux ortamda).

parameters:
    level: 5
    paths:
        - app/
    excludePaths:
        - app/Console/Kernel.php
    ignoreErrors:
        # === Filament Pages / Livewire Forms (magic method'lar) ===
        # Filament Pages base class'ında $this->form() magic method var
        - '#Access to an undefined property App\\Filament\\Pages\\.*\$form\.#'
        # Livewire Form trait — $this->form ve notify magic method'lar
        - '#Call to an undefined method .*::notify\(#'
        - '#Access to an undefined property .*\$form\.#'
        # Filament Resource — bulk actions onTable() vb. magic method'lar
        - '#Call to an undefined method Filament\\Actions\\Action::make\(#'

        # === SavedSearch $user / $created_at (dinamik property) ===
        - '#Access to an undefined property App\\Models\\SavedSearch::\$user\.#'
        - '#Access to an undefined property App\\Models\\SavedSearch::\$created_at\.#'

        # === User::$status / $name (cast edilmiş) ===
        - '#Access to an undefined property App\\Models\\User::\$status\.#'
        - '#Access to an undefined property App\\Models\\User::\$name\.#'

        # === DB stdClass (DB::selectOne, ::table()->first() sonuçları) ===
        - '#Cannot call method update\(\) on stdClass\.#'

        # === Eloquent scope notFound (filament type resolution sorunu) ===
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder<App\\Models\\ListingImage>::(withGps|pendingReverseGeocode|inCountry|inCity|pendingGeocode|withSensitiveExif|withinBounds|nearCoordinates)\(\)\.void#'

        # === Country::find (statik find) ===
        - '#Call to an undefined static method App\\Models\\Country::find\(\)\.void#'

        # === IcerikAyarlari $form (filament magic) ===
        - '#Access to an undefined property App\\Filament\\Pages\\IcerikAyarlari::\$form\.#'

        # === Geçersiz 'enqueue' model not found — özel tablolar ===
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder<App\\Models\\ListingImage>::(enqueue)\(\)\.void#'

        # === Various filament::notify() (ListPages/Pages'lar) ===
        - '#Call to an undefined method App\\Filament\\Resources\\ListingImages\\Pages\\ListListingImages::notify\(\)\.void#'

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
