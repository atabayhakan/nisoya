APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Performans izleme (production'da opsiyonel — her isteğin süre/sorgu/bellek
# metriklerini laravel.log'a yazar. Sorgu sayısı > 50 veya süre > 1000ms
# olan istekler 'warning' seviyesinde loglanır.
PERFORMANCE_LOG=false

# Query log (production için hafif query monitoring — N+1 + yavaş sorgu tespiti)
# Debugbar'ın yerine production'da daha hafif. Devre dışı bırakmak için false yapın.
QUERY_LOG_ENABLED=false
QUERY_LOG_SLOW_MS=200

# Yedekleme (deploy/backup.sh tarafından kullanılır)
BACKUP_DIR=/var/backups/nisoya          # Lokal yedek dizini
RETENTION_DAYS=14                        # Kaç gün tutulacak
S3_BACKUP_BUCKET=                        # S3 bucket adı (örn: nisoya-prod-backups). Boşsa offsite atlanır
BACKUP_ENCRYPTION_KEY=                   # GPG passphrase (boşsa şifreleme atlanır)
SLACK_BACKUP_WEBHOOK_URL=                # Slack bildirim webhook URL
DISCORD_BACKUP_WEBHOOK_URL=              # Discord bildirim webhook URL

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Google AdSense (gelir kaynağı)
# ----------------------------------------------------------------------------
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
# Auto Ads için tam <script> kodu (AdSense hesabından alıp admin panelden
# tek satır olarak yapıştırabilirsin). Boş bırakılırsa otomatik yüklenmez.
ADSENSE_AUTO_ADS_CODE=

# ----------------------------------------------------------------------------
# Google Analytics 4 (ölçüm)
# ----------------------------------------------------------------------------
ANALYTICS_ENABLED=false
ANALYTICS_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# Bağış (opsiyonel — ücretsiz hizmeti sürdürmek için)
# ----------------------------------------------------------------------------
DONATION_PAYPAL_ME=
DONATION_IBAN=
DONATION_IBAN_OWNER=

# ----------------------------------------------------------------------------
# MaxMind GeoLite2 (header'da ziyaretçi ülkesi bayrağı — ücretsiz, ticari
# kullanıma uygun, dış API çağrısı yok). Ücretsiz lisans anahtarı:
# https://www.maxmind.com/en/geolite2/signup
# ----------------------------------------------------------------------------
MAXMIND_LICENSE_KEY=

# ----------------------------------------------------------------------------
# Yapay Zeka (kamera-önce hızlı ilan görüntü analizi — Faz M3)
# Sağlayıcıdan bağımsız katman: AI_PROVIDER'ı değiştirmek dışında hiçbir kod
# değişikliği gerektirmez. Seçilen sağlayıcının anahtarını doldurman yeterli.
# Anahtar yoksa özellik kendiliğinden kapanır (site kırılmaz).
# Desteklenen: anthropic (varsayılan), openai, openrouter, gemini
# ----------------------------------------------------------------------------
AI_PROVIDER=anthropic
# AI_QUICK_LISTING=true   # anahtar varken bile özelliği kapatmak için false

# Anthropic (Claude) — görüntü destekli, düşük maliyetli varsayılan model
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (veya OpenAI-uyumlu: Azure/yerel — OPENAI_BASE_URL ile)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter — tek uçtan yüzlerce model (AI_PROVIDER=openrouter yap).
# Model adı sağlayıcı önekli: openai/gpt-4o-mini, google/gemini-2.0-flash-001, ...
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
