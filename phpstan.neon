includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app/
    excludePaths:
        - app/Console/Kernel.php
    ignoreErrors:
        # Filament Pages base class'ında $this->form() magic method var; PHPStan görmüyor
        - '#Access to an undefined property App\\Filament\\Pages\\.*\$form\.#'
        # Livewire Form trait — $this->form ve notify magic method'lar
        - '#Call to an undefined method .*::notify\(#'
        - '#Access to an undefined property .*\$form\.#'
        # Filament Resource — bulk actions onTable() vb. magic method'lar
        - '#Call to an undefined method Filament\\Actions\\Action::make\(#'
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
